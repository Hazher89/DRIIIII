<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Driftpro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>driftpro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DriftPro bruker posisjonen din mens appen er åpen for å knytte sted til avvik, følge leveringsoppgaver og støtte sjåførfunksjoner når du selv aktiverer dette.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DriftPro kan bruke posisjon i bakgrunnen kun under aktiv rute- eller leveringssporing når arbeidsgiver har aktivert dette for jobben din.</string>
	<key>NSCameraUsageDescription</key>
	<string>DriftPro trenger kameraet for å ta bilder til avvik, bilutleie, HMS-dokumentasjon, strekkodeskanning og GM &amp; STORO-etiketter — kun når du velger å ta bilde.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DriftPro trenger tilgang til bildebiblioteket når du velger vedlegg til avvik, HMS, personalmappe eller andre dokumenter. Vi laster ikke opp bilder uten at du velger dem.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>DriftPro kan lagre eksporterte bilder og dokumentasjon i Foto-appen når du velger å lagre eller eksportere.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DriftPro kan bruke mikrofonen når du tar video med lyd som dokumentasjon. Stillbilder krever ikke mikrofon.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DriftPro kobler til IP-kamera og lokal vision-tjeneste på bedriftens nettverk for uniform-monitor og live visning — kun på godkjent bedriftsnett.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>DriftPro bruker ikke sporing på tvers av apper eller nettsteder til reklame.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>no.driftpro.driftpro</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>no.driftpro.driftpro</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
