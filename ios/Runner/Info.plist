<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>DriftPro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DriftPro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>no.driftpro.driftpro</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>no.driftpro.driftpro</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>FlutterDeepLinkingEnabled</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>mailto</string>
		<string>tel</string>
		<string>sms</string>
		<string>maps</string>
		<string>comgooglemaps</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Eksempel: Når du tar bilde til et avvik, skanner en GM &amp; STORO-etikett eller dokumenterer bilutleie, brukes kameraet kun i det øyeblikket. DriftPro tar ikke bilder i bakgrunnen.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DriftPro kan koble til bedriftens lokale tjenester (for eksempel IP-kamera eller lokal vision-tjeneste) på godkjent bedriftsnettverk — kun når du eller bedriften aktiverer denne funksjonen.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Eksempel: Når du trykker «Oppdater posisjon» på et avvik, eller følger en levering/sjåføroppgave, brukes posisjonen din mens appen er i bruk. DriftPro ber ikke om bakgrunnssporing.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Eksempel: Mikrofon brukes bare hvis du tar video med lyd som dokumentasjon. Vanlige stillbilder og strekkodeskanning krever ikke mikrofon.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Eksempel: Når du eksporterer eller lagrer dokumentasjon, kan DriftPro lagre filen i Foto-appen — kun når du selv velger det.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Eksempel: Når du velger et vedlegg til avvik, HMS eller personalmappe, får DriftPro tilgang til bildene du plukker. Vi laster ikke opp bilder uten at du velger dem.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDarkContent</string>
</dict>
</plist>
