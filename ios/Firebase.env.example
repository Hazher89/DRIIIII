# Kopier til ios/Firebase.env og fyll inn fra Firebase Console → Project settings → DriftPro iOS app.
# ios/Firebase.env er gitignored. Kjør: bash ios/scripts/generate_google_service_info_plist.sh

FIREBASE_API_KEY=AIzaSy...
FIREBASE_APP_ID=1:123456789012:ios:abcdef1234567890
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_PROJECT_ID=driftpro-prod
FIREBASE_STORAGE_BUCKET=driftpro-prod.appspot.com
