# === Kamera — det eneste du vanligvis trenger å endre ===
CAMERA_HOST=192.168.39.190
CAMERA_URL=
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_ID=cam-komprimatorer
CAMERA_MODE=auto

# Sortering (begge komprimatorer i ett bilde)
EVENT_TYPE=sorting_clip
LOCAL_DEV=true
LOCAL_SERVER=true
LOCAL_SERVER_PORT=8090
LIVE_PUSH_INTERVAL_SECONDS=2
# UUID fra vision_cameras (Komprimatorer)
VISION_CAMERA_ID=5f823a5a-6466-42bc-b52f-b56aa5136302
SORTING_MODEL=models/yolov8s-worldv2.pt
CONFIDENCE_THRESHOLD=0.25
ENTRY_COOLDOWN_SECONDS=90

# 2 min før + 2 min etter (kun ved avvik)
CLIP_SECONDS_BEFORE=120
CLIP_SECONDS_AFTER=120
CLIP_FPS=2

# Soner: A = papp (venstre), B = annet (høyre) — normalisert 0–1
ZONE1_NAME=container_A_papp
ZONE1_RECT=0.0,0.15,0.48,0.95
ZONE2_NAME=container_B_annet
ZONE2_RECT=0.52,0.15,1.0,0.95

# Valgfritt produksjon (Dropbox via DriftPro)
# Kjør ENABLE_DROPBOX.ps1 på jobb-PC, eller sett manuelt:
# LOCAL_DEV=false
# SUPABASE_URL=https://ksnnyccthotjbrmgjgdc.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# COMPANY_ID=00000000-0000-0000-0000-000000000000
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_ROOT_FOLDER=/DriftPro/vision
